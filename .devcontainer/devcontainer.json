{
  "name": "mlops-training",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install --no-cache-dir -r .devcontainer/requirements.txt",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-toolsai.datawrangler",
        "mechatroner.rainbow-csv",
        "iterative.dvc"
      ]
    }
  },
  "hostRequirements": { "cpus": 2 }
}
